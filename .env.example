# Absolute origin for canonicals, sitemap.xml, robots.txt, JSON-LD and OG URLs. No trailing slash.
# Read once, in src/config/sitemap.ts. Unset, it falls back to https://letsfixwp.com, which is wrong
# on any other host: the whole site would then declare itself to be production. Set it on every
# non-production deploy to that deploy's own origin.
NEXT_PUBLIC_SITE_URL=https://letsfixwp.com

# Live chat, optional. Unset ships no vendor code and renders the fallback dialog instead.
# Supported providers: crisp, intercom, tawk, chatwoot. The host is for self-hosted Chatwoot only.
# NEXT_PUBLIC_CHAT_PROVIDER=crisp
# NEXT_PUBLIC_CHAT_ID=
# NEXT_PUBLIC_CHAT_HOST=
