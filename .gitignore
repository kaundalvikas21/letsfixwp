# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local secrets / per-machine config
.mcp.json
.claude/settings.local.json

# python bytecode from skill scripts
__pycache__/

# agent tooling residue (per-machine, written by skill launchers)
.agents/
.codex/
.superpowers/

# tool residue (per-machine): Lighthouse's Chrome profiles land here when its
# Windows temp path is taken literally under WSL; brag-output is the /brag skill's
brag-output*/
C:\\Users\\*

# brand film source (letsfixwp-film/): keep the code, ignore what build.sh regenerates
letsfixwp-film/out/
letsfixwp-film/stills/
letsfixwp-film/fonts/*.ttf
letsfixwp-film/vo/*.wav
letsfixwp-film/vo/.cache/
letsfixwp-film/vo/words.json
letsfixwp-film/music/score.wav
letsfixwp-film/*.mp4
